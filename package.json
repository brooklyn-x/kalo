{
  "name": "kalo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker/tsconfig.json",
    "test": "vitest run src/lib/domain src/lib/server",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kalo 'vitest run tests/firestore.rules.test.ts'"
  },
  "dependencies": {
    "@sveltejs/kit": "3.1.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-svelte": "1.0.1",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-vercel": "7.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "firebase-tools": "15.34.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
