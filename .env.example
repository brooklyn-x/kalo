# Firebase console -> Project settings -> Your apps -> Web app.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=
# Firebase Authentication UID of the single owner. Not an email address.
PUBLIC_OWNER_UID=
# Keep this equal to PUBLIC_OWNER_UID and the UID in firestore.rules.
OWNER_UID=
# Private server variables: never prefix with PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste a quoted PEM value with escaped newlines in local .env.
FIREBASE_PRIVATE_KEY=
USDA_API_KEY=
